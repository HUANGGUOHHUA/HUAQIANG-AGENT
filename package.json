{
  "name": "huaqiang-agent",
  "version": "1.0.1",
  "description": "华强以太 - 华强职校风格的本地 AI 编程 Agent",
  "main": "./out/main/index.js",
  "author": "Huaqiang Aetheon Project",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "prepare:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-python-runtime.ps1",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "pack:nsis": "npm run build && electron-builder --win portable --x64",
    "pack:dir": "npm run build && electron-builder --win dir --x64",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fast-glob": "^3.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  }
}
