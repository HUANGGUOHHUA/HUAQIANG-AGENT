root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,bat}]
end_of_line = crlf
indent_size = 4

# Windows PowerShell 5.1 reads BOM-less UTF-8 as ANSI/GBK.
# Keep this BOM or Chinese text becomes garbled parse errors.
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
